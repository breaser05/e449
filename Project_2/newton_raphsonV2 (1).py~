import numpy as np
import matplotlib as plt
import math

def functions(initialPoint):
    xk = initialPoint[0]
    yk = initialPoint[1]
    zk = initialPoint[2]
    F = 3*xk - math.cos(yk*zk)-0.5
    G = xk**2 -(81*(yk+0.1)**2)+math.sin(zk)+1.06
    H = math.e **-xk*yk+ 20*zk + (10*math.pi -3)/(3)

    F = np.array(
            [F,G,H])


    return F

def jacobians(initialPoint):
    xk = initialPoint[0]
    yk = initialPoint[1]
    zk = initialPoint[2]

    gx = 2 * xk
    gy = -162 * yk - 16.2
    gz = math.cos(zk)

    fx = 3
    fy = 9 + zk * math.sin(yk* zk)
    fz = yk * math.sin(yk*zk)

    hx = -yk * math.e**(xk*yk)
    hy = -xk * math.e**-(xk*yk)
    hz = 20

    J = np.array([
        [fx, fy, fz],
        [gx, gy, gz],
        [hx, hy, hz]
    ])

    return J

def initial_point():
    return np.array([0.1,0.1,-0.1])
    



def newton_raphson(function, jacobian, initialPoint, tol=1e-8, max_iter=100):
    I = initialPoint
    xk = I[0]
    yk = I[1]
    zk = I[2]
    iterations = 0
    while iterations <= max_iter:
        iterations += 1
        J = jacobians(np.array([xk, yk, zk]))
        F = functions(np.array([xk, yk, zk]))

        point = np.linalg.solve(J.linalg.inv(), F)

        if(point[0] < tol and point[1] < tol and point[2]< tol):
            max_abs_value = float(functions(point))
            return point, iterations, max_abs_value
        else:
            xk = point[0]
            yk = point[1]
            zk = point[2]
            print("iteration "+ str(iterations)+ str(point)+ "\n")

        




